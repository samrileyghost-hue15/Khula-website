# Cloudflare Worker -- local dev secrets
# Copy this file to .dev.vars (gitignored) and fill in values.
# These are injected by `wrangler dev` as environment bindings.
# In production, set them with: wrangler secret put <KEY>

# Your Supabase project URL
# Local:      http://127.0.0.1:54321
# Production: https://<project-ref>.supabase.co
SUPABASE_URL=

# Service-role key -- bypasses RLS for fast read access.
# Get from: Supabase dashboard -> Project Settings -> API -> service_role key
# NEVER expose this in frontend code or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key -- used for enquiry inserts so RLS rate-limiting applies.
# Get from: Supabase dashboard -> Project Settings -> API -> anon / public key
SUPABASE_ANON_KEY=
