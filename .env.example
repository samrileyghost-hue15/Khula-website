# KHULA by NKM -- Environment Variables
# Copy this file to .env and fill in values for your deployment.
# Never commit .env to version control.

# ── Site ──────────────────────────────────────────────────────────────────────
# Production site URL (used for canonical URLs and Open Graph)
VITE_SITE_URL=https://khulabynkm.co.za

# Contact email (shown in footer if set)
VITE_CONTACT_EMAIL=hello@khulabynkm.co.za

# ── Supabase (browser / frontend) ─────────────────────────────────────────────
# Required for database-backed features: portfolio, services, enquiry form.
# Get these from: Supabase dashboard -> Project Settings -> API
#
# Local dev (after running `supabase start`):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<printed by `supabase start`>
#
# Production (Supabase hosted project):
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon key from Supabase dashboard>
#
# NEVER put the service-role key here -- it bypasses RLS and must only live
# in the Cloudflare Worker (worker/.dev.vars) or other server-side code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (Worker / server-side only -- never in frontend) ─────────────────
# Used by the Cloudflare Worker to write enquiries with elevated privileges.
# Store this in worker/.dev.vars locally (gitignored) and as a Worker secret
# in production (`wrangler secret put SUPABASE_SERVICE_ROLE_KEY`).
# SUPABASE_SERVICE_ROLE_KEY=
